# ============================================================================
#  .env.example — MẪU cấu hình. Copy thành `.env` rồi điền giá trị thật.
#  `.env` đã được gitignore — TUYỆT ĐỐI không commit secret.
#
#  CHECKLIST tài khoản managed (PRD §6 · plan §5) — đăng ký & lấy thông tin:
#    [ ] Neon          https://neon.tech         → Connection string (Pooled)
#    [ ] Upstash Redis https://upstash.com       → rediss:// URL (TLS) + REST URL/Token
#    [ ] Qdrant Cloud  https://cloud.qdrant.io   → Cluster URL + API key
#    [ ] Langfuse      https://cloud.langfuse.com → Public + Secret key  (tùy chọn, phase sau)
#  Chưa có tài khoản? Chạy local: `make local-infra-up` rồi dùng mục LOCAL FALLBACK.
# ============================================================================

# ───────────────────────── App / Pipeline ─────────────────────────
# local = dev (uvicorn --reload). production = deploy (Render) — KHÔNG reload.
APP_ENV=local
LOG_LEVEL=INFO
# Bind uvicorn (slice 13). Dev: loopback. Render: HOST=0.0.0.0 và PORT do NỀN TẢNG tự cấp
# (đừng đặt tay PORT trên Render). Image Docker đã set sẵn HOST=0.0.0.0 + APP_ENV=production.
HOST=127.0.0.1
PORT=8000
# Slice-01: đặt true để BẬT parser thật (chỉ node parser đọc cờ này). false -> parser stub.
ENABLE_LLM=false
# Bật endpoint DEV (vd /api/agents/resume-screener thủ công của 08a). Mặc định false — đường thật
# của Screener là magic-link form (08b). Chỉ bật khi test nội bộ; KHÔNG bật ở production.
ENABLE_DEV_ENDPOINTS=false

# ───────────────────────── LLM — OpenAI (slice-01 Parser, PRD §7.1) ─
# Lấy key tại https://platform.openai.com/api-keys. KHÔNG commit key thật.
OPENAI_API_KEY=
# Model cho Parser (rẻ, hỗ trợ structured output). Mặc định code: gpt-4.1-mini.
PARSER_MODEL=gpt-4.1-mini
# Trần KÝ TỰ đọc từ MỘT CV, áp BÊN TRONG cv_reader (không phải sau khi trích xong). Chặn PDF phình:
# một file 0.918 MB HỢP LỆ trích ra 12.46 TRIỆU ký tự (~3.1M token ~ $0.36/request, ~260 MB RAM →
# OOM-kill instance Render 512 MB) qua endpoint nộp CV CÔNG KHAI. Chạm trần → cờ `cv_truncated` →
# hồ sơ LUÔN vào human_review (không lọt gate auto). 60k ~ 20-30 trang A4 dày chữ.
PARSER_MAX_CV_CHARS=60000
# Embedding JD → Qdrant (slice-02a). 1536 chiều — đổi model thì đổi EMBEDDING_DIM + collection mới.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Ranker chấm rubric (slice-02b). ĐÃ CHỌN qua benchmark (01c): gpt-5-mini + reasoning_effort=low —
# chấm bám bằng chứng (vd điểm Tiếng Anh khớp TOEIC), nhất quán trên dữ liệu sạch. Đổi model: sửa 2
# dòng dưới. REASONING_EFFORT rỗng = non-reasoning (temperature=0); có giá trị = reasoning (bỏ temperature).
RANKER_MODEL=gpt-5-mini
RANKER_REASONING_EFFORT=low
# Ngưỡng điểm đạt (0..100) + dải sát ngưỡng (cờ near_threshold).
SCORE_PASS_THRESHOLD=60
SCORE_NEAR_BAND=10
# AI gợi ý rubric (JD-3, PRD §12.1 FR-HR-RUBRIC-1). LLM đề xuất tiêu chí+trọng số từ JD (HR chỉnh/lưu).
# reasoning_effort (KHÔNG temperature — như ranker); rỗng = non-reasoning. Chọn effort qua benchmark
# (low đủ tốt cho tiêu chí+trọng số → mặc định low). MAX_RETRIES: cap gợi ý/JD, reset khi nội dung JD đổi.
RUBRIC_SUGGEST_MODEL=gpt-5-mini
RUBRIC_SUGGEST_REASONING_EFFORT=low
RUBRIC_SUGGEST_MAX_RETRIES=3

# Ngưỡng & mốc thời gian (PRD §5 trụ cột 3 · §9 gate · §10 screener).
# Đọc từ env — tinh chỉnh thực nghiệm ở Chương 4 (PRD §18).
CONFIDENCE_THRESHOLD=0.6
SCREENER_DEADLINE_HOURS=72
SCREENER_REMINDER_HOURS=24
# Nhịp của sweep loop in-process (08c, asyncio task ở lifespan — KHÔNG Redis polling). MỘT vòng chạy
# CẢ BA lưới: screener timeout/nhắc · hồ sơ kẹt giữa pipeline (14) · vòng đời lịch SCH-3 (nhắc buổi
# PV, nhắc chọn lịch, link đặt lịch hết hạn). Booking KHÔNG có nhịp riêng — đây là nhịp duy nhất.
# Đặt nhỏ (vd 20) khi verify các luồng nhắc/hết hạn, rồi KHÔI PHỤC.
SCREENER_SWEEP_INTERVAL_SECONDS=600
# Lưới đối soát hồ sơ KẸT giữa pipeline (BackgroundTasks không bền: restart/OOM/pool cạn → hồ sơ nằm
# mãi ở SUBMITTED trong khi ứng viên đã nhận "nộp thành công"). Quá ngần này phút → PENDING_REVIEW
# [error] cho HR, KHÔNG BAO GIỜ auto-reject. Phải LỚN HƠN NHIỀU thời gian pipeline thật (chục giây).
# <= 0 = tắt lưới.
STUCK_APPLICATION_TIMEOUT_MINUTES=30
# Gốc URL frontend công khai để dựng magic-link Screener (08b): {FRONTEND_BASE_URL}/screening/{token}.
# Dev: dashboard Next chạy :3000. Đổi khi deploy (domain thật).
FRONTEND_BASE_URL=http://localhost:3000

# ─────────────── Đặt lịch phỏng vấn — ứng viên tự chọn (SCH-1 · PRD §10b.7, FR-BOOK-5) ───────────────
# Khả dụng là TOÀN CỤC (không theo từng JD) — đúng mô hình single-tenant một công ty.
# Múi giờ chốt tường minh: DB lưu UTC, nhưng giờ làm việc là khái niệm ĐỊA PHƯƠNG.
BOOKING_TIMEZONE=Asia/Ho_Chi_Minh
# Ngày làm việc theo ISO weekday: 1=Thứ Hai … 7=Chủ Nhật. Nhận "1-5", "1,3,5", "1-5,7".
BOOKING_WORK_DAYS=1-5
BOOKING_WORK_START=08:00
BOOKING_WORK_END=17:30
# Nghỉ trưa "HH:MM-HH:MM" — slot nào ĐÈ lên khoảng này bị loại. Để RỖNG = không nghỉ trưa.
BOOKING_LUNCH=12:00-13:30
# Độ dài buổi phỏng vấn + đệm giữa hai buổi. Mốc bắt đầu cách nhau DURATION + BUFFER.
BOOKING_DURATION_MINUTES=60
BOOKING_BUFFER_MINUTES=15
# KHÔNG mời khung giờ sớm hơn ngần này kể từ lúc ứng viên bấm link (họ cần thời gian thu xếp).
BOOKING_LEAD_TIME_HOURS=24
# ⚠ SỨC CHỨA — "bao nhiêu ứng viên xem link cùng lúc thì lịch cạn". Mỗi lượt mở link giữ
# SLOTS_OFFERED khung trong HOLD_MINUTES, nên trần = tổng kho ÷ SLOTS_OFFERED.
#
# ⚠ ĐÍNH CHÍNH (LOAD-1, đo thật): kho KHÔNG phải MAX_PER_DAY × số ngày làm. Số khung mỗi ngày do
# LƯỚI GIỜ LÀM VIỆC sinh ra, MAX_PER_DAY chỉ là trần áp lên lưới. Cấu hình mặc định (08:00–17:30,
# duration 60 + buffer 15 ⇒ bước 75 phút, nghỉ trưa 12:00–13:30) chỉ ra 5 mốc/ngày: 08:00 · 09:15 ·
# 10:30 · 14:15 · 15:30 ⇒ 5 × 15 ngày làm = 75 khung ⇒ ~15 người xem đồng thời (người thứ 19 thấy
# trang trống). Con số cũ "≈90 khung ⇒ ~18 người" là suy từ công thức và SAI.
# ⇒ BOOKING_MAX_PER_DAY=6 là CONFIG CHẾT (lưới không bao giờ tới 6). Muốn tăng sức chứa THẬT: nới
# BOOKING_WORK_END, giảm BOOKING_BUFFER_MINUTES / BOOKING_DURATION_MINUTES, hoặc tăng WINDOW_DAYS.
BOOKING_MAX_PER_DAY=6
BOOKING_WINDOW_DAYS=21
# Số khung giờ đề xuất mỗi lần mở link — TRỘN vài mốc sớm nhất với vài mốc rải ngày/buổi khác
# (PRD §10b.4): 5 slot dồn một buổi sáng thì người bận đúng sáng đó xem như không có lựa chọn nào.
BOOKING_SLOTS_OFFERED=5
# ⚠ HAI ĐỒNG HỒ KHÁC NHAU — rất dễ nhầm (PRD §10b.3):
#   HOLD_MINUTES   = giữ chỗ trong MỘT phiên chọn. Ngắn không phạt ai: hết hold chỉ cần tải lại
#                    là có danh sách mới ngay (slot sinh LƯỜI lúc bấm link, không phải lúc gửi mail).
#   LINK_TTL_HOURS = ứng viên có bao lâu để BẮT ĐẦU đặt lịch. Token KHÔNG one-time (khác screener).
BOOKING_HOLD_MINUTES=5
BOOKING_LINK_TTL_HOURS=72
# ─── Vòng đời lịch (SCH-3 · PRD §10b.6, FR-BOOK-3/4) ───
# Nhắc TRƯỚC BUỔI PHỎNG VẤN — gửi MỘT lần khi buổi PV còn cách ngần này giờ (email + .ics đính kèm).
BOOKING_INTERVIEW_REMINDER_HOURS=24
# Nhắc CHỌN LỊCH — gửi MỘT lần khi liên kết còn ngần này giờ nữa hết hạn (đo theo thời gian CÒN LẠI,
# khác SCREENER_REMINDER_HOURS vốn đo từ lúc gửi). Hết hạn mà chưa đặt → hồ sơ về PENDING_REVIEW
# gắn cờ booking_no_response, KHÔNG BAO GIỜ auto-reject (im lặng ≠ từ chối).
# Đặt giá trị NHỎ (vd 0.02) để verify nhanh luồng nhắc/hết hạn mà không phải chờ thật.
BOOKING_REMINDER_HOURS=24
# Seam lịch ngoài (PRD §10b.8): ics = đính kèm .ics vào email, KHÔNG cần OAuth.
# 'google' (PRD §17) chỉ mới chừa đường, chưa triển khai.
CALENDAR_PROVIDER=ics

# ───────────────────────── Auth HR (slice 09 — PRD §4) ────────────────────
# CHỈ HR Admin đăng nhập; ứng viên là GUEST (không tài khoản). Tự làm auth: JWT trong cookie
# httpOnly + băm bcrypt. KHÔNG Clerk/OAuth/RBAC.
# JWT_SECRET: BẮT BUỘC, tối thiểu 32 ký tự ngẫu nhiên. Sinh: `openssl rand -hex 32`. KHÔNG commit.
JWT_SECRET=
JWT_EXPIRY_MINUTES=480
# Cookie chứa JWT — đọc từ ENV để deploy cross-domain KHÔNG phải sửa code:
#   dev  (localhost:3000 → :8000):        COOKIE_SECURE=false  COOKIE_SAMESITE=lax
#   prod (vercel.app → onrender.com, cross-site): COOKIE_SECURE=true  COOKIE_SAMESITE=none
# SameSite=none BẮT BUỘC kèm Secure=true (nếu không browser bỏ cookie).
AUTH_COOKIE_NAME=ars_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN trống = host-only (đúng cho cả dev lẫn cross-domain). Chỉ đặt nếu chia sẻ subdomain.
COOKIE_DOMAIN=
# Seed tài khoản HR admin ban đầu (scripts/seed_hr_admin.py). KHÔNG commit mật khẩu thật.
HR_ADMIN_EMAIL=admin@example.com
HR_ADMIN_PASSWORD=

# ───────────────────────── CORS (slice 13 — cross-domain Vercel + Render) ─
# Danh sách origin frontend được phép gọi backend, phân tách bằng dấu phẩy. KHÔNG có dấu / cuối.
#   dev : ĐỂ TRỐNG → tự cho phép localhost mọi cổng (không cần cấu hình gì).
#   prod: CORS_ORIGINS=https://<app>.vercel.app   (thêm cả domain preview nếu cần demo trên đó)
# KHÔNG dùng '*': trình duyệt CẤM wildcard khi gửi cookie → HR đăng nhập xong vẫn mất phiên.
# Backend sẽ NỔ ngay lúc khởi động nếu thấy '*' (cố ý — sai chỗ này rất khó chẩn đoán trên bản live).
CORS_ORIGINS=

# ───────────────────────── Hardening public endpoints (slice 13) ──────────
# Endpoint công khai (ứng viên guest) + đăng nhập HR nay ra internet. Giới hạn in-process theo IP.
# Body tối đa (byte) — CV giới hạn 10MB + phần bao multipart. Mặc định 12MB.
MAX_REQUEST_BYTES=12582912
RATE_LIMIT_ENABLED=true
# Đăng nhập HR: chống dò mật khẩu.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# Công khai (nộp CV + form screening): chống spam và dò token magic-link.
RATE_LIMIT_PUBLIC_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=3600
# Sau proxy (Render) IP thật nằm ở X-Forwarded-For chứ không phải peer TCP. ĐỂ TRỐNG = tự suy:
# bật khi APP_ENV khác "local". Quên bật khi deploy thì MỌI khách chung một khoá quota (peer = router
# của Render) → chỉ ~10 request nặc danh là khoá sạch đường đăng nhập của HR.
TRUST_PROXY_HEADERS=
# Header IP-client do proxy đặt (ưu tiên số 1 khi khoá quota). Cloudflare (đứng trước *.onrender.com)
# đặt CF-Connecting-IP = IP client THẬT + ghi đè giá trị client tự gửi → chuẩn xác, không giả mạo,
# KHÔNG phụ thuộc số chặng proxy. RỖNG = tắt (deploy KHÔNG qua Cloudflare) → rơi về đếm hop XFF.
PROXY_CLIENT_IP_HEADER=cf-connecting-ip
# DỰ PHÒNG khi header trên vắng mặt: số chặng proxy tin cậy, lấy phần tử thứ N TỪ PHẢI của XFF.
# Render+Cloudflare thực tế là 3 phần "client, cf, render" — nhưng đã ưu tiên CF-Connecting-IP nên
# hop chỉ là lưới an toàn. Xác nhận bằng log "Rate-limit: khóa quota = ..." (in MỘT lần).
PROXY_TRUSTED_HOPS=2

# ───────────────────────── Object storage CV (slice 06 — PRD §16, NFR-4) ─
# Nơi file CV nằm. local = đĩa dev (CV_UPLOAD_DIR) · r2 = Cloudflare R2 (S3 API) cho prod
# (file BỀN qua restart/redeploy). Nghiệp vụ đi qua seam FileStorage — đổi backend = đổi biến này.
STORAGE_BACKEND=local
# Cloudflare R2: tạo bucket PRIVATE + API token (S3 credentials) ở dash.cloudflare.com → R2.
# BUCKET PHẢI PRIVATE: CV là dữ liệu cá nhân (NFR-4) — HR tải qua endpoint stream có đăng nhập,
# KHÔNG bao giờ public URL. KHÔNG commit secret thật.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Để trống → suy ra https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ───────────────────────── Email Service (Resend) ────────────────────────
# Scheduler gửi thư mời/từ chối (PRD §7.4). Lấy API key ở https://resend.com.
RESEND_API_KEY=
# Địa chỉ gửi. Test: onboarding@resend.dev (chỉ gửi được tới email tài khoản Resend của bạn
# khi domain CHƯA xác thực). Demo public: địa chỉ thuộc domain đã xác thực DNS trên Resend.
EMAIL_FROM=onboarding@resend.dev
# Địa chỉ nhận thư TRẢ LỜI (EMAIL-1). Vừa là UX (ứng viên bấm Reply là tới HR thật) vừa là tín hiệu
# deliverability — địa chỉ gửi kiểu noreply@ không có hòm thư bị nhà cung cấp trừ điểm. Rỗng = không
# đặt reply_to.
EMAIL_REPLY_TO=
# Resend giới hạn 2 req/s — lượt gửi được nối tiếp hoá và cách nhau ít nhất ngần này (ms).
EMAIL_MIN_INTERVAL_MS=550
# Số lần thử lại tối đa cho lỗi TẠM THỜI (429 bùng nổ / 5xx / mạng). KHÔNG áp cho 400/422 (địa chỉ
# sai định dạng) và KHÔNG áp cho cạn quota ngày/tháng (thử lại một hạn mức đã cạn chỉ làm chậm mọi
# lá thư khác đang xếp hàng sau).
EMAIL_MAX_RETRIES=3

# ── Webhook Resend — vòng đời giao hàng (EMAIL-1, bounce/complaint) ────────
# Trỏ webhook trên Resend (Settings → Webhooks) vào: https://<backend>/api/webhooks/resend
# Secret ký webhook (`whsec_...`), lấy khi tạo webhook trên Resend. ⚠ CHƯA đặt → endpoint trả 503
# cho MỌI sự kiện (KHÔNG âm thầm nhận sự kiện không ký) → Resend thử lại vài lần rồi BỎ CUỘC ⇒ MẤT
# TÍN HIỆU BOUNCE vĩnh viễn cho những gì gửi trong lúc thiếu secret. Đặt biến này TRƯỚC khi tạo
# webhook trên Resend, không phải sau.
RESEND_WEBHOOK_SECRET=
# Cửa sổ chống replay theo svix-timestamp. Chữ ký đúng mà không có hạn thì một request hợp lệ bị
# chặn lại sẽ phát lại được mãi mãi.
RESEND_WEBHOOK_TOLERANCE_SECONDS=300
# Trần thân body RIÊNG cho webhook — KHÔNG dùng chung MAX_REQUEST_BYTES (12MB, cỡ dành cho upload
# CV). /api/webhooks/* là path công khai DUY NHẤT không có xô rate-limit (miễn trừ có chủ ý — Resend
# gọi từ vài IP cố định, siết theo IP sẽ mất sự kiện bounce trong im lặng), nên trần 12MB biến nó
# thành đường khuếch đại KHÔNG hạn mức. Payload Resend thật chỉ cỡ 1-2KB; 64KB đã rộng rãi gấp hàng
# chục lần mà vẫn nhỏ hơn nhiều so với 12MB.
RESEND_WEBHOOK_MAX_BYTES=65536

# ───────────────────────── Postgres (Neon) ────────────────────────
# Dùng dạng SQLAlchemy async (driver asyncpg).
# QUAN TRỌNG (CLAUDE.md): asyncpg KHÔNG hiểu ?sslmode=... — BỎ mọi query param;
# SSL được bật trong code qua connect_args={"ssl": True}.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME
# Kết nối RIÊNG cho LangGraph checkpointer (driver psycopg — Screener suspend/resume, PRD §10).
# ĐỂ TRỐNG = suy từ DATABASE_URL và tự BỎ '-pooler' để dùng endpoint Neon TRỰC TIẾP: PgBouncer chế độ
# transaction phá prepared statements của psycopg. Chỉ đặt tay khi cần một URL không-pooled khác.
CHECKPOINTER_DATABASE_URL=
CHECKPOINTER_POOL_MAX_SIZE=5
# ⚠ PHẢI NHỎ HƠN ngưỡng autosuspend của Neon (~300s) — pool tự đóng kết nối nhàn rỗi TRƯỚC khi Neon
# giết chúng. Đặt cao hơn thì request đầu tiên sau lúc nhàn rỗi mượn phải kết nối chết và nổ
# psycopg.errors.AdminShutdown (sự cố prod đã gặp — xem docs/deploy-live-issues.md).
CHECKPOINTER_POOL_MAX_IDLE_SECONDS=120

# ───────────────────────── Redis (Upstash) ────────────────────────
# rediss:// = TLS (bắt buộc với Upstash).
REDIS_URL=rediss://default:PASSWORD@HOST:6379
# REST API Upstash (chưa dùng ở scaffold — để trống cũng được):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ───────────────────────── Qdrant Cloud ───────────────────────────
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
# Collection dùng chung JD + CV (payload "type" phân biệt). Mặc định code: cv_jd_embeddings.
QDRANT_COLLECTION=cv_jd_embeddings

# ───────────────────────── Langfuse (observability, phase sau) ─────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ───────────────────────── LOCAL FALLBACK (docker-compose.local.yml) ─
# Bỏ comment 3 dòng dưới (và comment các URL managed ở trên) khi chạy local:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruitment
# REDIS_URL=redis://localhost:6379
# QDRANT_URL=http://localhost:6333

# ============================================================================
#  PROD — DANH SÁCH ENV ĐẶT TRÊN RENDER (slice 13 §4.2)
#
#  File .env KHÔNG được copy vào image (xem .dockerignore) — trên Render mọi giá trị đặt ở
#  Environment của service. Dán checklist này rồi điền. Giá trị KHÁC dev được đánh dấu ⚠.
#
#  ── Chạy ────────────────────────────────────────────────────────────────
#    ⚠ APP_ENV=production            ⚠ HOST=0.0.0.0   (PORT: Render tự cấp, ĐỪNG đặt tay)
#      ENABLE_LLM=true               ⚠ ENABLE_DEV_ENDPOINTS=false
#
#  ── Cross-domain: 3 biến này sai là HR đăng nhập xong mất phiên (rủi ro #1) ──
#    ⚠ CORS_ORIGINS=https://<app>.vercel.app       (origin frontend, KHÔNG '/' cuối, KHÔNG '*')
#    ⚠ COOKIE_SECURE=true      ⚠ COOKIE_SAMESITE=none      COOKIE_DOMAIN=   (để trống)
#    ⚠ FRONTEND_BASE_URL=https://<app>.vercel.app  (magic-link trong email screener trỏ về đây)
#      → Phía Vercel còn 3 biến PHẢI khớp với khối này (BACKEND_ORIGIN, NEXT_PUBLIC_API_BASE,
#        NEXT_PUBLIC_PUBLIC_API_BASE) — chúng KHÔNG nằm trong file này. Xem
#        `apps/dashboard/.env.example`. Đặc biệt `CORS_ORIGINS` ở trên phải chứa origin Vercel,
#        nếu không đường nộp CV gọi thẳng backend sẽ bị chặn CORS.
#
#  ── Secret MỚI cho prod (KHÔNG tái dùng giá trị dev) ────────────────────
#    ⚠ JWT_SECRET=            (sinh mới: openssl rand -hex 32)
#      JWT_EXPIRY_MINUTES=480    AUTH_COOKIE_NAME=ars_session
#      (HR_ADMIN_EMAIL / HR_ADMIN_PASSWORD: **KHÔNG đặt trên service**. Backend lúc chạy KHÔNG hề
#       đọc chúng — đăng nhập tra bảng hr_user rồi so bcrypt. Chỉ `scripts/seed_hr_admin.py` dùng,
#       nên chỉ cần có ở NƠI CHẠY script. Để lại trên dashboard = mật khẩu admin nằm phơi vĩnh viễn
#       mà chẳng đổi lấy chức năng gì. Xem mục "Seed tài khoản HR" bên dưới.)
#
#  ── Hạ tầng ─────────────────────────────────────────────────────────────
#    ⚠ DATABASE_URL=          (Neon branch PROD RIÊNG — đừng trỏ vào DB dev)
#      REDIS_URL=  QDRANT_URL=  QDRANT_API_KEY=  QDRANT_COLLECTION=
#      (cân nhắc QDRANT_COLLECTION riêng cho prod để vector dev không lẫn vào)
#
#  ── Lưu CV: BẮT BUỘC r2 trên prod ───────────────────────────────────────
#    ⚠ STORAGE_BACKEND=r2     (đĩa Render là ephemeral — local = MẤT CV mỗi lần redeploy)
#      R2_ACCOUNT_ID=  R2_ACCESS_KEY_ID=  R2_SECRET_ACCESS_KEY=  R2_BUCKET=  R2_ENDPOINT=
#      Bucket PHẢI PRIVATE (NFR-4).
#
#  ── LLM + email ─────────────────────────────────────────────────────────
#      OPENAI_API_KEY=  PARSER_MODEL=gpt-4.1-mini
#      RANKER_MODEL=gpt-5-mini  RANKER_REASONING_EFFORT=low   (bỏ effort là ranker hỏng)
#      RUBRIC_SUGGEST_MODEL=gpt-5-mini  RUBRIC_SUGGEST_REASONING_EFFORT=low  RUBRIC_SUGGEST_MAX_RETRIES=3
#      EMBEDDING_MODEL=text-embedding-3-small  EMBEDDING_DIM=1536
#      RESEND_API_KEY=  EMAIL_FROM=            (domain đã xác thực nếu gửi cho người ngoài)
#      EMAIL_REPLY_TO=                (địa chỉ HR thật nhận Reply — vừa UX vừa tín hiệu deliverability)
#      EMAIL_MIN_INTERVAL_MS=550  EMAIL_MAX_RETRIES=3
#    ⚠ RESEND_WEBHOOK_SECRET=       (lấy khi tạo webhook trên Resend — Settings → Webhooks. THIẾU
#      biến này thì /api/webhooks/resend trả 503 cho MỌI sự kiện; Resend thử lại vài lần rồi BỎ
#      CUỘC ⇒ MẤT TÍN HIỆU BOUNCE vĩnh viễn cho những gì gửi trong lúc thiếu secret — đặt biến này
#      TRƯỚC khi tạo webhook, và webhook trên Resend PHẢI trỏ https://<backend>/api/webhooks/resend)
#      RESEND_WEBHOOK_TOLERANCE_SECONDS=300  RESEND_WEBHOOK_MAX_BYTES=65536
#
#  ── Ngưỡng + hardening ──────────────────────────────────────────────────
#      CONFIDENCE_THRESHOLD=0.6  SCORE_PASS_THRESHOLD=60  SCORE_NEAR_BAND=10
#      SCREENER_DEADLINE_HOURS=72  SCREENER_REMINDER_HOURS=24
#      SCREENER_SWEEP_INTERVAL_SECONDS=600
#      STUCK_APPLICATION_TIMEOUT_MINUTES=30   (lưới cứu hồ sơ kẹt — xem ghi chú ở trên)
#      BOOKING_TIMEZONE=Asia/Ho_Chi_Minh  BOOKING_WORK_DAYS=1-5  BOOKING_WORK_START=08:00
#      BOOKING_WORK_END=17:30  BOOKING_LUNCH=12:00-13:30  BOOKING_DURATION_MINUTES=60
#      BOOKING_BUFFER_MINUTES=15  BOOKING_LEAD_TIME_HOURS=24  BOOKING_MAX_PER_DAY=6
#      BOOKING_WINDOW_DAYS=21  BOOKING_SLOTS_OFFERED=5  BOOKING_HOLD_MINUTES=5
#      BOOKING_LINK_TTL_HOURS=72  CALENDAR_PROVIDER=ics
#      BOOKING_INTERVIEW_REMINDER_HOURS=24  BOOKING_REMINDER_HOURS=24
#                                (giờ làm việc của CÔNG TY, không phải của máy chủ — máy chủ chạy UTC)
#                                MAX_PER_DAY × ngày làm trong WINDOW = kho khung giờ; mỗi lượt ứng
#                                viên mở link giữ SLOTS_OFFERED khung ⇒ đặt quá thấp là lịch cạn sớm)
#      TRUST_PROXY_HEADERS=            (để trống: tự bật vì APP_ENV=production)
#      PROXY_CLIENT_IP_HEADER=cf-connecting-ip   (Render có Cloudflare → khoá quota theo IP client
#                                thật; log "Rate-limit: khóa quota" phải ra IP khách, KHÔNG phải 10.x)
#      PROXY_TRUSTED_HOPS=2           (chỉ là dự phòng khi thiếu CF-Connecting-IP)
#      RATE_LIMIT_ENABLED=true  RATE_LIMIT_LOGIN_MAX=10  RATE_LIMIT_PUBLIC_MAX=20
#      MAX_REQUEST_BYTES=12582912
#      CHECKPOINTER_POOL_MAX_IDLE_SECONDS=120   (< ~300s autosuspend Neon → pool tự đóng kết nối
#                                nhàn rỗi trước khi Neon giết; kèm check-on-borrow, sửa pipeline hỏng)
#
#  ── Seed tài khoản HR trên prod (KHÔNG cần Shell — gói free của Render không có) ────
#      Chạy TỪ MÁY BẠN, trỏ thẳng vào DB prod; env chỉ sống trong đúng lệnh này:
#        DATABASE_URL='<url prod>' HR_ADMIN_EMAIL='...' HR_ADMIN_PASSWORD='...' \
#          uv run --directory apps/backend python ../../scripts/seed_hr_admin.py
#      IDEMPOTENT và CỐ Ý không đổi mật khẩu của tài khoản đã có (tránh ghi đè nhầm) — nên chạy lại
#      với mật khẩu khác sẽ KHÔNG đổi được mật khẩu; muốn đổi thì phải cập nhật hàng hr_user.
#
#  ── Render: cấu hình service (KHÔNG phải env var) ───────────────────────
#      Health Check Path = /api/health/live    ← KHÔNG phải /api/health (bản kiểm sâu ping cả 3
#      dịch vụ; Render ping vài giây/lần sẽ đốt sạch hạn mức Upstash free 10k lệnh/ngày)
#      Dockerfile Path = ./Dockerfile · Build Context = .  · Instance: tiến-trình-bền (không serverless)
# ============================================================================
