# ============================================================================
#  ARS — biến môi trường (BACKEND). Copy sang `.env` rồi điền. KHÔNG commit `.env`.
#
#  File này chỉ còn HAI loại biến:
#    · BÍ MẬT      — khoá API, mật khẩu, JWT secret.
#    · KHỞI ĐỘNG   — thứ phải biết TRƯỚC khi có DB (chuỗi kết nối, host/port, CORS, cookie,
#                    backend lưu file). Đổi lúc chạy KHÔNG có tác dụng: chúng được đọc một lần
#                    lúc nạp tiến trình.
#
#  Hằng số NGHIỆP VỤ (ngưỡng chấm điểm, mốc nhắc/timeout, giờ làm việc + toàn bộ BOOKING_*,
#  nhịp gửi email, giới hạn parser…) KHÔNG còn ở đây. Chúng nằm trong bảng `app_config` và
#  sửa được tại  /system → tab "Cấu hình"  (đăng nhập HR). Mặc định nằm trong
#  `apps/backend/app/core/config.py`; nhãn + giải thích + ràng buộc từng ô nằm trong
#  `apps/backend/app/core/config_registry.py`.
#
#  Thứ tự ưu tiên lúc khởi động:  app_config (DB)  ›  biến môi trường  ›  mặc định trong code.
#  Bảng rỗng = chạy hoàn toàn theo mặc định của code — không cần seed gì sau khi migrate.
#
#  Biến của FRONTEND (Vercel) ở file RIÊNG: `apps/dashboard/.env.example`.
#  Checklist đặt gì trên Render/Vercel: `docs/deploy-checklist.md`.
#
#  Đăng ký dịch vụ:
#    [ ] Neon (Postgres)  https://neon.tech            → connection string
#    [ ] Qdrant Cloud     https://cloud.qdrant.io      → URL + API key
#    [ ] Cloudflare R2    https://dash.cloudflare.com  → bucket PRIVATE + khoá S3
#    [ ] OpenAI           https://platform.openai.com  → API key
#    [ ] Resend           https://resend.com           → API key + webhook secret
# ============================================================================

# ───────────────────────── Chạy ───────────────────────────────────────────
APP_ENV=local                      # local | production. `local` mới bật reload.
LOG_LEVEL=INFO
HOST=127.0.0.1                     # prod: 0.0.0.0 (Render tự cấp PORT — đừng đặt tay)
PORT=8000

# false = parser/ranker chạy nhánh STUB (không gọi OpenAI, không tốn tiền — dùng cho test).
# true = gọi LLM THẬT. Người mới clone thường quên biến này rồi tưởng hệ thống chấm điểm sai.
ENABLE_LLM=false
# Endpoint chẩn đoán chỉ dành cho dev. PHẢI false trên prod.
ENABLE_DEV_ENDPOINTS=false

# ───────────────────────── Postgres (Neon) ────────────────────────────────
# Neon cần SSL. Driver là asyncpg → dùng `connect_args={"ssl": True}` trong code,
# KHÔNG thêm `?sslmode=` vào URL (asyncpg không parse được).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruitment

# Checkpointer LangGraph (suspend/resume của Screener) dùng psycopg, KHÔNG dùng asyncpg —
# để trống thì suy ra từ DATABASE_URL. Chỉ đặt khi muốn tách sang một endpoint Neon khác.
CHECKPOINTER_DATABASE_URL=
CHECKPOINTER_POOL_MAX_SIZE=5
# ⚠ PHẢI NHỎ HƠN ngưỡng autosuspend của Neon (~300s): pool tự đóng kết nối nhàn rỗi TRƯỚC khi
# Neon giết chúng. Đặt cao hơn thì request đầu tiên sau lúc nhàn rỗi mượn phải kết nối chết và
# nổ `psycopg.errors.AdminShutdown` — sự cố prod đã gặp, xem docs/deploy-live-issues.md.
CHECKPOINTER_POOL_MAX_IDLE_SECONDS=120

# ───────────────────────── Qdrant Cloud (vector JD–CV) ────────────────────
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=cv_jd_embeddings
# Số chiều vector — BẤT BIẾN của collection. Đổi model embedding thì phải đổi số này VÀ tạo
# collection MỚI; vì thế nó nằm ở đây chứ không ở màn Cấu hình.
EMBEDDING_DIM=1536

# ───────────────────────── OpenAI ─────────────────────────────────────────
OPENAI_API_KEY=
# (Chọn model + hạn giờ + giới hạn kích thước CV: /system → Cấu hình)

# ───────────────────────── Email (Resend) ─────────────────────────────────
RESEND_API_KEY=
# Chữ ký webhook giao hàng (bounce/complaint/failed). Thiếu là webhook bị từ chối hết.
RESEND_WEBHOOK_SECRET=
# (Địa chỉ gửi/reply-to, nhịp gửi, số lần retry: /system → Cấu hình)

# ───────────────────────── Lưu file CV (PRD §16, NFR-4) ───────────────────
STORAGE_BACKEND=local              # local (đĩa, dev) | r2 (Cloudflare R2 — BẮT BUỘC trên prod)
# Chỉ dùng khi STORAGE_BACKEND=local. Để trống = `apps/backend/data/uploads`.
CV_UPLOAD_DIR=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Ghi đè endpoint S3 (thường không cần — suy ra từ R2_ACCOUNT_ID).
R2_ENDPOINT=
# Số luồng riêng cho I/O storage. Đọc MỘT LẦN lúc dựng thread pool.
STORAGE_EXECUTOR_WORKERS=8

# ───────────────────────── Auth HR (PRD §4) ───────────────────────────────
# ⚠ ≥ 32 ký tự. THIẾU BIẾN NÀY thì đăng nhập ném lỗi cấu hình, không phải 401 — rất dễ chẩn
# đoán nhầm thành "sai mật khẩu". Sinh: openssl rand -hex 32
JWT_SECRET=
AUTH_COOKIE_NAME=ars_session
COOKIE_SECURE=false                # prod (cross-domain): true
COOKIE_SAMESITE=lax                # prod (cross-domain): none
COOKIE_DOMAIN=                     # để trống = host-only (đúng cho cả dev lẫn cross-domain)
# (Thời gian giữ phiên: /system → Cấu hình)

# Đầu vào của `scripts/seed_hr_admin.py` — hệ thống KHÔNG có luồng tự đăng ký. Backend lúc chạy
# KHÔNG đọc hai biến này, nên KHÔNG cần đặt chúng trên Render.
HR_ADMIN_EMAIL=
HR_ADMIN_PASSWORD=

# ───────────────────────── CORS + cookie cross-domain ─────────────────────
# CSV các origin ĐẦY ĐỦ (có scheme, KHÔNG có path, KHÔNG có '/' cuối). Starlette so chuỗi CHÍNH
# XÁC nên '*', thiếu scheme, hay thừa '/' đều cho cùng một triệu chứng: "login 200 nhưng mất
# phiên". Để trống = fallback regex localhost cho dev.
CORS_ORIGINS=
# Magic-link trong email (sàng lọc, đặt lịch) trỏ về đây.
FRONTEND_BASE_URL=http://localhost:3000

# ───────────────────────── Hardening endpoint công khai ───────────────────
MAX_REQUEST_BYTES=12582912         # 12 MB
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_PUBLIC_MAX=20
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=3600
# Có tin header proxy để lấy IP thật không. Để trống = tự suy theo APP_ENV.
# ⚠ Sai vế này là hỏng theo hướng nguy hiểm: không tin thì khoá quota = router của nền tảng ⇒
# CẢ THẾ GIỚI CHUNG MỘT XÔ; tin nhầm thì ai cũng giả được IP. Xem docs/deploy-live-issues.md.
TRUST_PROXY_HEADERS=
PROXY_CLIENT_IP_HEADER=cf-connecting-ip
PROXY_TRUSTED_HOPS=2

# ───────────────────────── Tải đồng thời + nền ────────────────────────────
# Trần pipeline chạy song song. Đọc MỘT LẦN lúc dựng van (đổi lúc chạy không có tác dụng), nên
# nó ở đây chứ không ở màn Cấu hình. Nút thắt thật là khoá của AsyncPostgresSaver, KHÔNG phải
# thread pool — xem docs/load-and-scale.md.
MAX_CONCURRENT_PIPELINES=15
# Nhịp sweep loop in-process (asyncio task ở lifespan — KHÔNG hàng đợi ngoài). MỘT vòng chạy CẢ
# BA lưới: timeout/nhắc sàng lọc · hồ sơ kẹt giữa pipeline · vòng đời lịch. Đọc lúc khởi động.
SCREENER_SWEEP_INTERVAL_SECONDS=600

# Nhà cung cấp lịch. Hiện chỉ nhận 'ics' (đính kèm .ics; Google Calendar để sau).
CALENDAR_PROVIDER=ics

# ───────────────────────── LOCAL FALLBACK (docker-compose.local.yml) ──────
# Bỏ comment 2 dòng dưới (và comment các URL managed ở trên) khi chạy hạ tầng local:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recruitment
# QDRANT_URL=http://localhost:6333
